---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
  const entries = await getCollection('playLogs', ({ data }) => data.status === 'published' || data.status === 'template');
  return Promise.all(entries.map(async (entry) => ({
    params: { slug: entry.id },
    props: { entry, rendered: await render(entry) },
  })));
}

const { entry, rendered } = Astro.props;
const { Content } = rendered;
const dateLabel = entry.data.date?.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' }) ?? '日期留白';
const isTemplate = entry.data.status === 'template';
---

<SiteLayout title={entry.data.title} description={`遊玩記錄：${entry.data.gameTitle}`}>
  {isTemplate && <p class="template-ribbon"><strong>範本預覽</strong>｜此頁只展示 Markdown 記錄版型，不代表實際遊玩經驗。</p>}
  <main id="main-content" class="reader-page log-entry-page">
    <article class="log-entry">
      <p class="eyebrow">PLAY SESSION / {dateLabel}</p>
      <h1>{entry.data.title}</h1>
      <p class="log-entry__game">{entry.data.gameTitle}</p>
      <div class="log-entry__meta">
        {entry.data.session && <span>{entry.data.session}</span>}
        {entry.data.mood && <span>{entry.data.mood}</span>}
      </div>
      <div class="log-entry__body"><Content /></div>
      <a class="text-link" href={withBase('/play-log/')}>返回遊玩記錄</a>
    </article>
  </main>
</SiteLayout>

<style>
  .log-entry-page { max-width: 960px; }
  .log-entry { max-width: 760px; margin-inline: auto; padding: clamp(1.5rem, 5vw, 4rem); border-left: 1px solid rgba(219, 169, 141, 0.58); background: linear-gradient(100deg, rgba(58, 42, 70, 0.42), transparent 90%); }
  .log-entry h1 { margin: 0.6rem 0 0.2rem; font-family: var(--font-serif); font-size: clamp(2rem, 5.5vw, 3.4rem); font-weight: 400; letter-spacing: 0.08em; }
  .log-entry__game { margin: 0; color: var(--gold-200); font-family: var(--font-serif); letter-spacing: 0.1em; }
  .log-entry__meta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1rem; color: var(--paper-400); font-size: 0.74rem; }
  .log-entry__body { margin: 2.5rem 0; color: var(--paper-200); font-family: var(--font-serif); line-height: 2.1; }
  .log-entry__body h2 { margin-top: 2.4rem; color: var(--paper-100); font-size: 1.25rem; font-weight: 400; }
  .log-entry__body p { margin: 0 0 1.35rem; }
</style>
