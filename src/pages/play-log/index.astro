---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { withBase } from '../../utils/paths';

const entries = (await getCollection('playLogs', ({ data }) => data.status === 'published'))
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
---

<SiteLayout title="遊玩記錄" description="以 Markdown 撰寫的視覺小說遊玩札記與閱讀進度。">
  <main id="main-content" class="reader-page">
    <div class="section-kicker">FILE 02　／　PLAY LOG</div>
    <header class="page-lede">
      <p class="eyebrow">BETWEEN CHAPTERS</p>
      <h1>遊玩記錄</h1>
      <p>將每次開啟遊戲的片刻留作時間戳：讀到哪裡、停在哪裡，以及當下想記下的事。</p>
    </header>

    <section aria-label="遊玩記錄索引">
      {entries.length > 0 ? (
        <ol class="log-list">
          {entries.map((entry) => (
            <li>
              <time datetime={entry.data.date?.toISOString()}>{entry.data.date?.toLocaleDateString('zh-TW') ?? '未註明日期'}</time>
              <div>
                <h2><a href={withBase(`/play-log/${entry.id}/`)}>{entry.data.title}</a></h2>
                <p>{entry.data.gameTitle}{entry.data.session ? ` · ${entry.data.session}` : ''}</p>
              </div>
              <span aria-hidden="true">↗</span>
            </li>
          ))}
        </ol>
      ) : (
        <div class="empty-state">
          <span class="empty-state__mark" aria-hidden="true">⌁</span>
          <p class="eyebrow">FILE 00 · THE PAGE IS STILL OPEN</p>
          <h2>遊玩記錄尚未刊出</h2>
          <p>這裡會依日期排列遊玩札記。尚未填入實際遊玩內容，目前沒有公開記錄。</p>
          <a class="text-link" href={withBase('/about/')}>查看遊玩記錄版型</a>
        </div>
      )}
    </section>
  </main>
</SiteLayout>

<style>
  .log-list { margin: 0; padding: 0; border-top: 1px solid rgba(213, 182, 204, 0.2); list-style: none; }
  .log-list li { display: grid; grid-template-columns: 9rem 1fr auto; align-items: baseline; gap: 1.2rem; padding: 1.5rem 0; border-bottom: 1px solid rgba(213, 182, 204, 0.16); }
  .log-list time { color: var(--gold-300); font-size: 0.75rem; letter-spacing: 0.08em; }
  .log-list h2 { margin: 0; font-family: var(--font-serif); font-size: 1.2rem; font-weight: 400; letter-spacing: 0.06em; }
  .log-list p { margin: 0.15rem 0 0; color: var(--paper-400); font-size: 0.82rem; }
  .log-list li > span { color: var(--gold-300); }
  @media (max-width: 640px) { .log-list li { grid-template-columns: 1fr auto; gap: 0.35rem 1rem; } .log-list time { grid-column: 1; } .log-list li > div { grid-column: 1; } .log-list li > span { grid-column: 2; grid-row: 1 / span 2; } }
</style>
